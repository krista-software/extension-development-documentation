<!-- src/main/resources/docs/index.html — the in-platform Documentation tab (Docsify).
     Bundled via @StaticResource(path="docs", file="docs") and surfaced by customTabs() -> "static/docs". -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{EXT_NAME}} Extension</title>
  <link rel="stylesheet" href="//cdn.jsdelivr.net/npm/docsify@4/lib/themes/vue.css">
</head>
<body>
  <div id="app">Loading…</div>
  <script>
    window.$docsify = {
      name: '{{EXT_NAME}} Extension',
      loadSidebar: true,
      subMaxLevel: 2,
      homepage: 'pages/README.md'
    };
  </script>
  <script src="//cdn.jsdelivr.net/npm/docsify@4"></script>
</body>
</html>
