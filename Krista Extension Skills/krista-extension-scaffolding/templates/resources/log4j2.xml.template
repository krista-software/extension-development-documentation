<?xml version="1.0" encoding="UTF-8"?>
<!-- Place at src/main/resources/log4j2.xml. Verbatim shape from the github extension. -->
<Configuration status="error">
    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="%-5p %c{1}:%L - %m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- Root at INFO to suppress noisy third-party debug logs -->
        <Root level="info">
            <AppenderRef ref="console"/>
        </Root>

        <!-- Your extension package at DEBUG -->
        <Logger name="{{PACKAGE}}" level="debug" additivity="false">
            <AppenderRef ref="console"/>
        </Logger>
        <Logger name="app.krista" level="debug" additivity="false">
            <AppenderRef ref="console"/>
        </Logger>

        <!-- Suppress noisy third-party libraries -->
        <Logger name="okhttp3" level="warn"/>
        <Logger name="org.apache.http" level="warn"/>
        <Logger name="org.apache.http.wire" level="off"/>
        <Logger name="org.apache.http.headers" level="off"/>
        <Logger name="com.kristasoft.jaxrs.netty" level="warn"/>
        <Logger name="com.kristasoft.common.io" level="warn"/>
        <Logger name="io.netty" level="warn"/>
    </Loggers>
</Configuration>
