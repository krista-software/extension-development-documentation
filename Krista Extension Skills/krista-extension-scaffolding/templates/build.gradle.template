// =====================================================================================================
// CORE — the fat jar. Bundles all `implementation` deps. Enable the buildAndCopyUI dependsOn only if
// you enabled the React UI block above.
// =====================================================================================================
tasks.named("jar") {
    dependsOn tasks.named("generateReleaseProperties")
    // dependsOn tasks.named("buildAndCopyUI")   // enable with the React UI block
}

jar {
    dependsOn tasks.named("setReleaseProperties")
    dependsOn includeSources
    archiveBaseName = project.ext.has("finalBaseName") ? project.ext.finalBaseName : "{{EXT_NAME}}-extension"
    manifest {}
    from { configurations.implementation.collect { it.isDirectory() ? it : zipTree(it) } }
    exclude 'META-INF/*.RSA', 'META-INF/*.SF', 'META-INF/*.DSA'
    duplicatesStrategy = "exclude"
}

test {
    useJUnitPlatform()
    testLogging {
        events "passed", "skipped", "failed"
        exceptionFormat "full"
    }
    finalizedBy jacocoTestReport   // remove if you disable the JaCoCo block
}
