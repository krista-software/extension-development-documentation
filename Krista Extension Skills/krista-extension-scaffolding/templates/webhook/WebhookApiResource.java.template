package {{PACKAGE}}.api;

import app.krista.extensions.util.EventHandler;
import app.krista.model.base.FreeForm;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import javax.inject.Inject;
import javax.ws.rs.Consumes;
import javax.ws.rs.POST;
import javax.ws.rs.Path;
import javax.ws.rs.Produces;
import javax.ws.rs.core.MediaType;
import javax.ws.rs.core.Response;

/**
 * Inbound webhook handler. Receives the vendor POST, converts it to a FreeForm, and bridges it into
 * the platform via EventHandler.handleEvent(eventName, payload). A @CatalogRequest(WAIT_FOR_EVENT)
 * whose first two params are (eventName:Text, eventData:FreeForm) then consumes that event.
 *
 * Full route: rest/<jaxrsId>/<Application @ApplicationPath>/<this @Path>/<method @Path>.
 */
@Path("webhooks")
public final class {{WEBHOOK_RESOURCE_CLASS}} {

    private static final Logger LOGGER = LoggerFactory.getLogger({{WEBHOOK_RESOURCE_CLASS}}.class);

    // Event-name discriminator consumed by the WAIT_FOR_EVENT catalog request:
    public static final String EVENT_NAME = "{{EVENT_NAME}}";
    public static final String PAYLOAD_KEY = "{{PAYLOAD_KEY}}";

    private final EventHandler eventHandler;

    @Inject
    public {{WEBHOOK_RESOURCE_CLASS}}(EventHandler eventHandler) {
        this.eventHandler = eventHandler;
    }

    @POST
    @Path("/event")
    @Consumes(MediaType.APPLICATION_JSON)
    @Produces(MediaType.APPLICATION_JSON)
    public Response onEvent(String requestBody) {
        // Some providers require echoing a verification "challenge" on the first call — handle that here.
        try {
            FreeForm payload = new FreeForm();
            payload.put(PAYLOAD_KEY, "Text", requestBody);
            eventHandler.handleEvent(EVENT_NAME, payload);
            return Response.status(Response.Status.OK).entity("{\"status\":\"received\"}").build();
        } catch (Exception e) {
            LOGGER.error("Failed to process webhook", e);
            return Response.status(Response.Status.INTERNAL_SERVER_ERROR).build();
        }
    }
}
